// NOTE: ReadCurrent solved by --auto-read; the paper's value did not admit
// a valid sense scheme at a safe MTJ read bias.

-MemCellType: MRAM                             // [reported] title/abstract
-MemCellLevel: SLC                             // [assumed] no MLC discussion anywhere in paper
