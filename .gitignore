__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# DESTINY design-sweep scratch (regenerated by stage1; large, machine-specific)
stage1_destiny/cfgs/
stage1_destiny/out/

# Fetched/built dependencies (setup.sh clones and builds these; do not commit)
tools/ChampSim/
tools/NVMExplorer/
tools/*.log

# DESTINY build output (setup.sh builds this from tools/destiny_v2 source;
# a compiled binary/object files have no business in source control)
tools/destiny_v2/destiny
tools/destiny_v2/obj/
*.o

# Prepared traces are large binary intermediates regenerated from traces/sample_raw
traces/sample_prepared/

# Anything written directly under results/ by a local run is scratch by default.
# The three result sets actually shipped in this repo (paper_final, sample, smoke)
# are explicitly whitelisted below so a plain `git status` after running
# ./run_all.sh does not show your own output as tracked-and-modified.
results/*
!results/.gitkeep
!results/paper_final/
!results/paper_final/**
!results/sample/
!results/sample/**
!results/smoke/
!results/smoke/**

# Local run logs
logs/
